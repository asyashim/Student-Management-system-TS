```html
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Edit Profile</title>

    <link rel="stylesheet"
        href="/css/student/editProfile.css">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>


<body>

    <div class="edit-page">

        <div class="edit-container">

            <!-- Back -->

            <a href="/student/profile"
                class="back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Profile

            </a>


            <!-- Card -->

            <div class="edit-card">

                <!-- Header -->

                <div class="edit-header">

                    <div class="avatar">

                        <%= student.name.charAt(0).toUpperCase() %>

                    </div>

                    <div>

                        <h1>Edit Profile</h1>

                        <p>
                            Update your personal information
                        </p>

                    </div>

                </div>


                <!-- Form -->

                <form
                    action="/student/profile/edit"
                    method="POST">


                    <!-- Name -->

                    <div class="form-group">

                        <label for="name">
                            Full Name
                        </label>

                        <div class="input-box">

                            <i class="fa-solid fa-user"></i>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                value="<%= student.name %>"
                                required>

                        </div>

                    </div>


                    <!-- Email -->

                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="input-box disabled">

                            <i class="fa-solid fa-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                value="<%= student.email %>"
                                disabled>

                        </div>

                        <small>
                            Email cannot be changed.
                        </small>

                    </div>


                    <!-- Age -->

                    <div class="form-group">

                        <label for="age">
                            Age
                        </label>

                        <div class="input-box">

                            <i class="fa-solid fa-calendar"></i>

                            <input
                                type="number"
                                id="age"
                                name="age"
                                value="<%= student.age %>"
                                min="1"
                                required>

                        </div>

                    </div>


                    <!-- Course -->

                    <div class="form-group">

                        <label for="course">
                            Course
                        </label>

                        <div class="input-box">

                            <i class="fa-solid fa-book"></i>

                            <input
                                type="text"
                                id="course"
                                name="course"
                                value="<%= student.course %>"
                                required>

                        </div>

                    </div>


                    <!-- Phone -->

                    <div class="form-group">

                        <label for="phone">
                            Phone Number
                        </label>

                        <div class="input-box">

                            <i class="fa-solid fa-phone"></i>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                value="<%= student.phone %>"
                                required>

                        </div>

                    </div>


                    <!-- Buttons -->

                    <div class="form-actions">

                        <a
                            href="/student/profile"
                            class="cancel-btn">

                            Cancel

                        </a>

                        <button
                            type="submit"
                            class="save-btn">

                            <i class="fa-solid fa-check"></i>

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

</html>
```
