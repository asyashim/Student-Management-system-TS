<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Students</title>
    <link rel="stylesheet" href="/css/admin/students.css">
</head>
<body>

    <header>
        <div class="logo">Student Management</div>
        <nav>
            <a href="/">Home</a>
            <a href="/admin/students">Students</a>
            <a href="/admin/students/add">Add Student</a>
        </nav>
    </header>

    <main>
        <div class="students-container">

            <div class="page-header">
                <h1>All Students</h1>
                <a href="/admin/students/add" class="btn">+ Add Student</a>
            </div>

            <% if (students.length === 0) { %>
                <div class="empty">
                    <p>No students found. <a href="/admin/students/add">Add one now</a>.</p>
                </div>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Age</th>
                            <th>Course</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach((student, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= student.name %></td>
                            <td><%= student.email %></td>
                            <td><%= student.age %></td>
                            <td><%= student.course %></td>
                            <td><%= student.phone %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>

        </div>
    </main>

    <footer>
        <p>© 2026 Student Management System</p>
    </footer>

</body>
</html>
