<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>

    <header>
        <div class="logo">Student Management</div>
        <nav>
            <a href="/">Home</a>
            <a href="/admin/students">Students</a>
            <a href="/admin/students/add">Add Student</a>
        </nav>
    </header>

    <main>

        <section class="hero">
            <div class="hero-content">
                <h1>Student Management System</h1>
                <p>Manage student information easily and efficiently.</p>
                <div class="buttons">
                    <a href="/admin/students" class="btn">View Students</a>
                    <a href="/admin/students/add" class="btn secondary">Add Student</a>
                </div>
            </div>
        </section>

        <section class="features">
            <h2>What You Can Do</h2>
            <div class="cards">
                <div class="card">
                    <h3>👨‍🎓 Manage Students</h3>
                    <p>Add and manage student information.</p>
                </div>
                <div class="card">
                    <h3>📋 View Students</h3>
                    <p>View all registered students in one place.</p>
                </div>
                <div class="card">
                    <h3>✏️ Update Information</h3>
                    <p>Easily update student details whenever needed.</p>
                </div>
                <div class="card">
                    <h3>🗑️ Delete Students</h3>
                    <p>Remove student records when necessary.</p>
                </div>
            </div>
        </section>

    </main>

    <footer>
        <p>© 2026 Student Management System</p>
    </footer>

</body>
</html>
