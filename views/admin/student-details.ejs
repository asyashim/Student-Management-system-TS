<!DOCTYPE html>
<html>
<head>
    <title>Student Details</title>
</head>

<body>

    <h1>Student Details</h1>

    <div>
        <h2><%= student.name %></h2>

        <p>
            <strong>Email:</strong>
            <%= student.email %>
        </p>

        <p>
            <strong>Age:</strong>
            <%= student.age %>
        </p>

        <p>
            <strong>Course:</strong>
            <%= student.course %>
        </p>

        <p>
            <strong>Phone:</strong>
            <%= student.phone %>
        </p>
    </div>

    <a href="/admin/students">Back to Students</a>
    <a href="/admin/dashboard">Home</a>

</body>
</html>