{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "commonjs",
    //"moduleResolution": "node",
    "target": "ES2020",

    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,

    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}